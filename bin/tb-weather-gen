#!/usr/bin/env python3
"""tb-weather-gen — generate the org-weather JSON snapshot from a Tightbeam
instance's state.db (opened strictly read-only) and publish it next to the
web page.

Configuration (environment variables):
  TB_BASE_DIR      Tightbeam base directory. Default: ~/.tightbeam
  TB_WEATHER_OUT   Where to write data.json. Default: /tmp/tb-weather.json
  TB_WEATHER_DEST  Optional scp destination (user@host:/path/data.json).
                   If unset, the snapshot is only written to TB_WEATHER_OUT —
                   use that when the web root is on the same machine.
  TB_WEATHER_KEY   Optional ssh identity file for the scp push.
  TB_WEATHER_REPO  Optional path to a clone of the code repo. When set, each
                   item's recorded commits are tested for ancestry in
                   TB_WEATHER_BRANCH, which is the only reliable way to know
                   whether work actually landed — review verdicts say the
                   gate passed, not that code reached the branch.
  TB_WEATHER_BRANCH  Branch to test against. Default: origin/main
  TB_ATC_API       Optional base URL of this install's own ATC API
                   (e.g. http://127.0.0.1:8899/api). When set, the generator
                   mirrors open operator decision requests onto the board as
                   author=atc:desk arrows/tags/one search. Unset: the
                   `decisions` feed field is still populated (it only reads
                   state.db), the board sync is simply skipped.

Every signal is derived from durable rows: stages from attest kinds and
verdicts, running turns from open rows in `turns`, queued turns from pending
`wakes`, pulses from recently fired wakes. Nothing is estimated. Decisions are
no different: the desk layer reads `decision_requests` straight out of
state.db (mode=ro), the same connection everything else here uses — it never
shells out to the `tightbeam` CLI. CLI reads append to `events` on a cadence,
which is exactly what grew state.db to 4.9GB and cascaded into a VM crash
(clickety-clacks/tightbeam#10).
"""
import hashlib, json, os, re, sqlite3, subprocess, time, urllib.error, urllib.request
from pathlib import Path

BASE = Path(os.environ.get("TB_BASE_DIR", str(Path.home() / ".tightbeam")))
DB = f"file:{BASE}/state.db?mode=ro"
OUT = os.environ.get("TB_WEATHER_OUT", "/tmp/tb-weather.json")
DEST = os.environ.get("TB_WEATHER_DEST")
KEY = os.environ.get("TB_WEATHER_KEY")
REPO = os.environ.get("TB_WEATHER_REPO")            # optional git clone
BRANCH = os.environ.get("TB_WEATHER_BRANCH", "origin/main")
ATC_API = os.environ.get("TB_ATC_API")              # optional, e.g. http://127.0.0.1:8899/api
DESK_AUTHOR = "atc:desk"

def kind_of(name):
    n = name.lower()
    if n == "main": return "main"
    if "product owner" in n: return "po"
    if "patrol" in n or "watchdog" in n: return "patrol"
    if "orchestrator" in n: return "orch"
    if "coder" in n: return "coder"
    if "review" in n: return "rev"
    if "spec" in n: return "spec"
    return "coder"

con = sqlite3.connect(DB, uri=True)
con.row_factory = sqlite3.Row
q = lambda sql, *a: con.execute(sql, a).fetchall()

# ---- ground truth for "merged": ancestry in the real branch.
# No attest kind carries this. An item can hold completion, reviewed-clean,
# AND verified and still not be on the branch, so the branch is the only
# authority. Without a configured repo, merge state is simply unknown.
branch_shas, branch_pfx = set(), set()
if REPO and Path(REPO, ".git").exists():
    git = lambda *a: subprocess.run(["git", "-C", REPO, *a],
                                    capture_output=True, text=True)
    stamp = Path(OUT + ".fetch")                    # refresh at most every 5m
    try: stale = time.time() - stamp.stat().st_mtime > 300
    except OSError: stale = True
    if stale:
        git("fetch", "--quiet", "--all")
        stamp.touch()
    out = git("rev-list", BRANCH).stdout.split()
    branch_shas = set(out)
    branch_pfx = {s[:12] for s in out}

# which items ever produced code? a ruling or a recon has nothing to merge,
# so it must not read as a pending merge. assignment_effects is optional.
try:
    code_items = {r["workItemId"] for r in q(
        """SELECT DISTINCT a.workItemId FROM assignment_effects e
           JOIN assignments a ON a.id = e.assignmentId
           WHERE e.effectKind IN ('code','release','live_mutation')""")}
except sqlite3.Error:
    code_items = None                       # unavailable: treat every item as code

# cherry-picked and rebased work lands under a different sha, so ancestry
# alone reports false "not merged". Fall back to patch equivalence, cached
# per branch tip because it costs a subprocess per commit.
EQUIV = Path(OUT + ".equiv.json")
PROBE_V = 2                       # bump when probe semantics change
_tip = git("rev-parse", BRANCH).stdout.strip() if branch_shas else ""
try:
    _c = json.load(open(EQUIV))
    equiv_cache = (_c["map"] if _c.get("tip") == _tip
                   and _c.get("v") == PROBE_V else {})
except Exception:
    equiv_cache = {}

def probe(c):
    """True: equivalent content is on the branch. False: it is not.
    None: the commit is not in this clone, so nothing can be concluded."""
    if c in equiv_cache: return equiv_cache[c]
    if git("cat-file", "-e", c + "^{commit}").returncode != 0:
        r = None
    else:
        r = git("cherry", BRANCH, c, c + "~1").stdout.strip().startswith("-")
    equiv_cache[c] = r
    return r

def merged_in_branch(refs):
    if not branch_shas or not refs: return None     # detection unavailable
    for c in refs:
        if c in branch_shas or c[:12] in branch_pfx: return True
        if len(c) < 12 and any(s.startswith(c) for s in branch_shas): return True
    seen = [probe(c) for c in refs]
    if any(v is True for v in seen): return True
    if all(v is None for v in seen): return None    # unverifiable, not absent
    return False

NOW = int(time.time() * 1000)

# ---- when did each session last actually do anything? Role keywords are a
# guess at a name; this is a fact. Turns and attests are the two places a
# session leaves a timestamp when it acts.
last_act = {}
def _mark(key, ts):
    if key and ts and ts > last_act.get(key, 0):
        last_act[key] = ts
for r in q("""SELECT sessionKey, max(coalesce(endedAt, startedAt, createdAt)) AS t
              FROM turns GROUP BY sessionKey"""):
    _mark(r["sessionKey"], r["t"])
for r in q("SELECT bySession, max(ts) AS t FROM attests GROUP BY bySession"):
    _mark(r["bySession"], r["t"])

# ---- agents: active sessions, plus retired ones still holding open cards
# archetype and model come from the same row: what an agent IS and what is
# thinking for it are the two questions asked most often about a node, and
# both were a CLI round trip away until now.
rows = q("""SELECT sessionKey, displayName, state, spawnedBy,
                   archetype, harness, model FROM sessions""")
holders_open = {r["holderKey"] for r in q(
    "SELECT DISTINCT holderKey FROM assignments WHERE state='open'")}
sess = {r["sessionKey"]: r for r in rows
        if r["state"] == "active" or r["sessionKey"] in holders_open}
# Stable, addressable agent ids. Enumeration order changes between snapshots,
# so positional ids could not be used by anything outside this process; the
# session's own suffix is stable and matches what the CLI shows.
def _agent_id(session_key):
    # hash() is salted per process, so a fallback id built from it changed on
    # every run: that agent could never be selected, tagged or addressed, and
    # its links churned with it. A digest is stable across processes.
    tail = session_key.rsplit(" ", 1)[-1]
    if tail.startswith("s_"):
        return tail
    return "a" + hashlib.blake2b(session_key.encode(), digest_size=4).hexdigest()
ids = {k: _agent_id(k) for k in sess}
agents = []
for k, r in sess.items():
    kind = kind_of(r["displayName"] or "")
    # a top-of-tree session whose name classifies as nothing else is an
    # owner-level mind (e.g. a PO named after its product), not a worker
    if kind == "coder" and not r["spawnedBy"]:
        kind = "po"
    agents.append({
        "id": ids[k],
        "name": (r["displayName"] or k)[:120],
        "kind": kind,
        "archetype": (r["archetype"] or None),
        "harness": (r["harness"] or None),
        "model": (r["model"] or None),
        "parent": ids.get(r["spawnedBy"]),
        "retired": r["state"] != "active",
        "turn": None,
        "idleFor": (NOW - last_act[k]) // 1000 if k in last_act else None,
    })
mains = [a for a in agents if a["kind"] == "main"]
root = mains[0]["id"] if mains else (agents[0]["id"] if agents else None)
for a in agents:
    if a["parent"] is None and a["id"] != root:
        a["parent"] = root

# ---- turn activity
running_sessions = {r["sessionKey"] for r in q(
    "SELECT DISTINCT sessionKey FROM turns WHERE startedAt IS NOT NULL AND endedAt IS NULL")}
item_running = {}
for r in q("""SELECT t.sessionKey, a.workItemId FROM turns t
              JOIN assignments a ON a.id = t.assignmentId
              WHERE t.startedAt IS NOT NULL AND t.endedAt IS NULL"""):
    item_running.setdefault(r["workItemId"], set()).add(r["sessionKey"])
# TETHERS ARE TURN STATE, not wake state. A turn is queued when its row exists
# but has not started, and running once it has; both bind to a card through the
# assignment. A scheduled wake is an intention, not a turn, and draws nothing.
item_run, item_queue = {}, {}
for r in q("""SELECT t.sessionKey, t.startedAt, a.workItemId FROM turns t
              JOIN assignments a ON a.id = t.assignmentId
              WHERE t.endedAt IS NULL"""):
    bucket = item_run if r["startedAt"] else item_queue
    bucket.setdefault(r["workItemId"], set()).add(r["sessionKey"])

pending = {r["sessionKey"] for r in q(
    "SELECT DISTINCT sessionKey FROM wakes WHERE state='pending' AND dueAt <= ?",
    NOW + 60_000)}

# ---- engaged: a non-retired agent holding at least one open assignment, or
# the target of a pending wake — both facts already computed above (holders_
# open, pending). "45 agents" reads as 45 working; this is the count that is
# actually true.
agent_by_id = {a["id"]: a for a in agents}
for k in sess:
    a = agent_by_id.get(ids[k])
    if a is not None:
        a["engaged"] = (not a["retired"]) and (k in holders_open or k in pending)

# ---- work items with evidence stages
items = []
# open items, plus items that landed recently (their cards are all closed by
# definition — a resolved item holds no open assignments, so keying landed
# visibility off holders would hide every merge)
LANDED_WINDOW = 72 * 3600 * 1000
rows = q("""SELECT w.id, w.title, w.state FROM work_items w
            WHERE w.state='open'
               OR (w.state='closed' AND (SELECT max(a.closedAt)
                   FROM assignments a WHERE a.workItemId=w.id) > ?)
            ORDER BY w.createdAt DESC LIMIT 400""", NOW - LANDED_WINDOW)

# Everything the per-item loop needs, fetched in four set-based queries rather
# than four per item. At ~230 items that was ~700 round trips and 2.5s; the
# same facts cost a few dozen ms in bulk, which is what lets the snapshot be
# regenerated on a pulse instead of on a five-minute timer.
wids = [r["id"] for r in rows]
holes = ",".join("?" * len(wids))

def by_item(sql, *pre):
    out = {}
    if not wids:
        return out
    for row in q(sql.replace("{IN}", holes), *pre, *wids):
        out.setdefault(row[0], []).append(row)
    return out

holders_by = by_item("""SELECT workItemId, holderKey FROM assignments
                        WHERE state='open' AND workItemId IN ({IN})""")
ev_by = by_item("""SELECT a.workItemId, t.kind, t.verdictKind, t.commitRefs, t.ts,
                          a.reviewsAssignmentId AS reviews FROM attests t
                   JOIN assignments a ON a.id=t.assignmentId
                   WHERE a.workItemId IN ({IN})""")
closed_by = by_item("""SELECT workItemId, max(closedAt) AS m FROM assignments
                       WHERE workItemId IN ({IN}) GROUP BY workItemId""")
# ordered by dueAt so the first row per item is the imminent one
wake_by = by_item("""SELECT work_item_id, sessionKey FROM wakes
                     WHERE state='pending' AND work_item_id IN ({IN})
                     ORDER BY dueAt""")

for r in rows:
    wid = r["id"]
    holders = [ids[h["holderKey"]] for h in holders_by.get(wid, ())
               if h["holderKey"] in ids]
    holders = list(dict.fromkeys(holders))          # the DISTINCT the query used to do
    has_open_assignment = bool(holders_by.get(wid))
    ev = ev_by.get(wid, ())
    # A code review's reviewed-clean legitimately carries the commit under
    # review, so review refs count. What must not count is an item that never
    # produced code: a read-only DESIGN review cites the repository base it
    # read at, and reading that as an output made design work show as merged
    # off whatever happened to be the tip that day.
    refs, prod_refs = set(), set()
    for e in ev:
        if not e["commitRefs"]:
            continue
        found = re.findall(r'"commit"\s*:\s*"([0-9a-f]{7,40})"', e["commitRefs"])
        refs.update(found)
        if e["reviews"] is None:
            prod_refs.update(found)     # a producer citing a commit means code
    kinds = {e["kind"] for e in ev}
    verd = {e["verdictKind"] for e in ev if e["verdictKind"]}
    closed_at = None
    if r["state"] == "closed" and not has_open_assignment:
        stage = 6
        lc = closed_by.get(wid)
        closed_at = lc[0]["m"] if lc else None
    else:
        stage = 0
        if "progress" in kinds: stage = 1
        if "tests-passed" in verd: stage = 2
        if "completion" in kinds: stage = 3
        if verd & {"reviewed-clean", "spec-reviewed", "verified"}: stage = 4
        # A review only clears the work it actually saw. If the producer filed
        # again after the last reviewed-clean, that verdict is stale and the
        # item is back in review, not ready to merge.
        last_clean = max((e["ts"] for e in ev if e["verdictKind"] == "reviewed-clean"),
                         default=None)
        # Completion AFTER a review is the normal sequence — the completion rail
        # requires a linked review, so it always lands just after the verdict.
        # What makes a review stale is new code TESTED after it.
        last_tested = max((e["ts"] for e in ev
                           if e["verdictKind"] == "tests-passed"), default=None)
        stale_review = (last_clean is not None and last_tested is not None
                        and last_tested > last_clean + 300_000)
        if ("completion" in kinds and "reviewed-clean" in verd and not stale_review
                and not has_open_assignment):
            stage = 5
    # green = a turn is executing on this card; yellow = a turn is queued for it
    turns, turn_sk = {}, {}
    for sk in item_run.get(wid, ()):
        if sk in ids:
            turns[ids[sk]] = "run"; turn_sk[ids[sk]] = sk
    for sk in item_queue.get(wid, ()):
        if sk in ids and ids[sk] not in turns:
            turns[ids[sk]] = "wait"; turn_sk[ids[sk]] = sk
    # which way the waiting prompt flows. "in" = toward this agent (it owes the
    # turn); "out" = the item is waiting on someone else. When prompts are
    # pending in both directions the earliest dueAt wins.
    imminent = wake_by.get(wid, ())
    tgt = imminent[0]["sessionKey"] if imminent else None
    flow = {aid: ("in" if (tgt is None or sk == tgt) else "out")
            for aid, sk in turn_sk.items()}
    is_code = True if code_items is None else (wid in code_items or bool(prod_refs))
    # the page decides how much of a title to show; truncating here threw the
    # rest away before anything could ask for it
    # The FULL id, because anything reading this view has to be able to act on
    # it: `tightbeam work-item-get` refuses a short id with unknown_work_item.
    # `short` is for display only.
    items.append({"id": wid, "short": wid[:11], "title": (r["title"] or "")[:2000],
                  "stage": stage, "holders": holders, "turns": turns, "flow": flow,
                  # nothing to merge means no merge state, not a green ring
                  "closedAt": closed_at,
                  "merged": merged_in_branch(refs) if is_code else None,
                  # effect tags are advisory and often incomplete, so a commit
                  # filed BY A PRODUCER also proves code
                  "code": is_code})
# show the whole open sky so drainage is visible; landings by closure recency
open_items = [w for w in items if w["stage"] < 6][:240]
landed = sorted((w for w in items if w["stage"] >= 6),
                key=lambda w: w["closedAt"] or 0, reverse=True)[:16]

# ---- traffic: every delivered message, not just wakes. Wakes are a small
# subset; the messages table is where the conversation actually lives.
# Senders are role paths, resolved through the roles table's binding.
role_of = {"agent:" + r["name"]: r["boundSessionKey"]
           for r in q("SELECT name, boundSessionKey FROM roles "
                      "WHERE boundSessionKey IS NOT NULL")}
msgs = []
for r in q("""SELECT id, sessionKey, sender FROM messages
              WHERE timestamp > ? ORDER BY timestamp DESC LIMIT 400""",
           NOW - 300000):
    dst = ids.get(r["sessionKey"])
    if not dst:
        continue
    sender = r["sender"] or ""
    if sender.startswith("agent:"):
        src = ids.get(role_of.get(sender))
        if not src or src == dst:
            continue
        msgs.append({"id": r["id"], "from": src, "to": dst, "kind": "agent"})
    elif sender.startswith("user:"):
        msgs.append({"id": r["id"], "to": dst, "kind": "user"})
    else:                                   # process:* and the substrate itself
        msgs.append({"id": r["id"], "to": dst, "kind": "substrate"})

# ---- agent-level activity
amap = {a["id"]: a for a in agents}
for k in sess:
    if k in running_sessions: amap[ids[k]]["turn"] = "run"
    elif k in pending: amap[ids[k]]["turn"] = "wait"

# ---- wakes are their own channel: a wake is a nudge, a message is speech
wakes_out = []
for r in q("""SELECT wakeId, creatorSessionKey, sessionKey FROM wakes
              WHERE state='fired' AND firedAt > ?
              ORDER BY firedAt DESC LIMIT 200""", NOW - 300000):
    src = ids.get(r["creatorSessionKey"])
    dst = ids.get(r["sessionKey"])
    if src and dst and src != dst:
        wakes_out.append({"id": r["wakeId"], "from": src, "to": dst})

# ---- agent-to-agent links: a pending wake IS an obligation between two
# agents. Green when the receiver is in a turn, yellow when it still owes one.
# Agent-to-agent links follow the TURN the wake produced, not the wake.
# A wake fires within seconds of its due time (p50 0s), so "pending" only means
# "not due yet". The real waiting is the turn sitting in the receiver's queue
# behind earlier prompts: p90 is about fourteen minutes, and it runs to an hour.
links = []
for r in q("""SELECT t.wakeId, w.creatorSessionKey, t.sessionKey, t.startedAt
              FROM turns t JOIN wakes w ON w.wakeId = t.wakeId
              WHERE t.endedAt IS NULL"""):
    src, dst = ids.get(r["creatorSessionKey"]), ids.get(r["sessionKey"])
    if src and dst and src != dst:
        links.append({"id": r["wakeId"], "from": src, "to": dst,
                      "state": "run" if r["startedAt"] else "wait"})

# ---- desk: open operator decision requests, straight out of state.db.
# Effort-kind requests are machine-ruled by process:tightbeam and are not
# desk items; the kind='operator' filter already excludes them (the table's
# own CHECK constraint ties kind='effort' to raiserId='process:tightbeam').
# decision_requests is a Tightbeam 0.1.8+ table: an older gateway, or a test
# fixture that predates it, simply has no desk data — not a reason to fail
# every other signal this snapshot carries.
decisions = []
try:
    decision_rows = q("""SELECT id, raiserId, raiserSessionKey, ownerUserId, assignmentId,
                                raisedAt, deadlineAt, question, options, context
                         FROM decision_requests WHERE kind='operator' AND status='open'""")
except sqlite3.OperationalError:
    decision_rows = []
for r in decision_rows:
    try:
        opts = [o["label"] for o in json.loads(r["options"] or "[]")
                if isinstance(o, dict) and o.get("label")]
    except (TypeError, ValueError):
        opts = []
    try:
        ctx = json.loads(r["context"] or "{}")
        if not isinstance(ctx, dict): ctx = {}
    except (TypeError, ValueError):
        ctx = {}
    wid = None
    if r["assignmentId"]:
        arow = q("SELECT workItemId FROM assignments WHERE id=?", r["assignmentId"])
        wid = arow[0]["workItemId"] if arow else None
    decisions.append({
        "id": r["id"], "question": r["question"], "options": opts,
        "note": ctx.get("note"), "supersedes": ctx.get("supersedes"),
        "raiserId": r["raiserId"], "raiserAgentId": ids.get(r["raiserSessionKey"]),
        "assignmentId": r["assignmentId"], "workItemId": wid,
        "ownerUserId": r["ownerUserId"],
        "raisedAt": r["raisedAt"], "deadlineAt": r["deadlineAt"],
    })

def _atc_http(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json"} if data is not None else {}
    req = urllib.request.Request(ATC_API + path, data=data, method=method, headers=headers)
    with urllib.request.urlopen(req, timeout=3) as resp:
        raw = resp.read()
        return json.loads(raw) if raw else {}

def sync_desk(decisions):
    """Mirror open, not-yet-expired decisions onto the board as author=
    atc:desk arrows/tags/one search. This is the ONLY writer of that author,
    so an author-scoped diff can never touch anything another author wrote.
    A request past its deadline but still status='open' drops its arrow/tag
    here (spec: ruled/withdrawn/expired all clear the annotation) — the desk
    strip itself, driven by the `decisions` feed field, keeps showing it,
    greyed, from the raw row regardless."""
    active = [d for d in decisions if d["deadlineAt"] > NOW]
    try:
        state = _atc_http("GET", "/state")
    except (urllib.error.URLError, OSError, ValueError):
        return   # a display sync must never fail the primary snapshot

    cur_arrows = {(a["from"], a["to"]): a["arrowId"]
                  for a in state.get("arrows", []) if a.get("author") == DESK_AUTHOR}
    cur_tags = {t["target"]: (t["tagId"], t["text"])
                for t in state.get("tags", []) if t.get("author") == DESK_AUTHOR}
    cur_search = next((s for s in state.get("searches", [])
                        if s.get("author") == DESK_AUTHOR), None)

    want_arrows, want_ids, best_ms = set(), set(), {}
    for d in active:
        raiser = d["raiserAgentId"]
        if not raiser:
            continue
        want_ids.add(raiser)
        if d["workItemId"]:
            want_arrows.add((raiser, d["workItemId"]))
            want_ids.add(d["workItemId"])
        ms = d["deadlineAt"] - NOW
        if raiser not in best_ms or ms < best_ms[raiser]:
            best_ms[raiser] = ms
    want_tags = {}
    for raiser, ms in best_ms.items():
        hours = max(0, ms) // 3_600_000
        want_tags[raiser] = (f"needs George · {hours}h" if hours >= 1
                              else "needs George · <1h")

    try:
        for key, arrow_id in cur_arrows.items():
            if key not in want_arrows:
                _atc_http("DELETE", "/arrows/" + arrow_id)
        new_arrows = [{"from": f, "to": t, "text": "awaiting ruling", "color": "red",
                       "source": "agent", "author": DESK_AUTHOR}
                      for (f, t) in want_arrows if (f, t) not in cur_arrows]
        if new_arrows:
            _atc_http("POST", "/arrows", {"arrows": new_arrows})

        for raiser, (tag_id, text) in cur_tags.items():
            if want_tags.get(raiser) != text:
                _atc_http("DELETE", "/tags/" + tag_id)
        new_tags = [{"target": raiser, "text": text, "color": "red",
                     "source": "agent", "author": DESK_AUTHOR}
                    for raiser, text in want_tags.items()
                    if raiser not in cur_tags or cur_tags[raiser][1] != text]
        if new_tags:
            _atc_http("POST", "/tags", {"tags": new_tags})

        if want_ids:
            body = {"ids": sorted(want_ids), "label": "where George is needed",
                    "author": DESK_AUTHOR, "source": "agent"}
            if cur_search:
                body["searchId"] = cur_search["searchId"]
            _atc_http("POST", "/searches", {"searches": [body]})
        elif cur_search:
            _atc_http("DELETE", "/searches/" + cur_search["searchId"])
    except (urllib.error.URLError, OSError, ValueError):
        pass   # best-effort; the next tick re-diffs from scratch and retries

if ATC_API:
    sync_desk(decisions)

snap = {"generatedAt": NOW, "agents": agents, "links": links,
        "items": open_items + landed, "messages": msgs, "wakes": wakes_out,
        "decisions": decisions}
json.dump(snap, open(OUT, "w"))
if branch_shas:
    json.dump({"tip": _tip, "v": PROBE_V, "map": equiv_cache}, open(EQUIV, "w"))
if DEST:
    cmd = ["scp", "-q"]
    if KEY: cmd += ["-i", KEY, "-o", "IdentitiesOnly=yes"]
    subprocess.run(cmd + [OUT, DEST], check=True)
pending = [w for w in open_items
           if w["stage"] >= 5 and w["code"] and w["merged"] is False]
print(f"snapshot: {len(agents)} agents, {len(open_items)} open, "
      f"{len(landed)} landed, {len(msgs)} msgs, "
      f"{len(pending)} awaiting a real merge")
