#!/usr/bin/env bash
# tb-weather-watch — regenerate the snapshot when the Tightbeam database
# changes, with a heartbeat fallback. Runs on the Tightbeam host.
#
# Change detection is SQLite's own `PRAGMA data_version`, which moves whenever
# another connection commits. It costs microseconds, needs no packages, and
# catches updates to existing rows — a turn ending, an item closing — which
# watching the WAL for writes or counting rows both miss. inotify was the old
# mechanism and is not always installed; when it was missing this fell back to
# regenerating every five seconds whether or not anything had happened.
#
# Config (environment):
#   TB_BASE_DIR       Tightbeam base dir (default ~/.tightbeam)
#   TB_WEATHER_GEN    path to tb-weather-gen (default: alongside this script)
#   TB_WEATHER_MINGAP minimum seconds between regenerations (default 10)
#   TB_WEATHER_PULSE  seconds between change checks (default 0.5)
#   TB_WEATHER_BEAT   seconds between heartbeats when nothing changes (default 30)
set -u
BASE="${TB_BASE_DIR:-$HOME/.tightbeam}"
DB="$BASE/state.db"
GEN="${TB_WEATHER_GEN:-$(dirname "$0")/tb-weather-gen}"
# A COOLDOWN between runs, not between starts. Measured from the start, a gap
# shorter than the pass is no gap at all: the database changes constantly, so
# the generator simply ran back-to-back. A pass is ~6s now, so a short gap
# keeps the board live while leaving the core mostly idle.
MIN_GAP="${TB_WEATHER_MINGAP:-10}"

last=0
regen(){
  now=$(date +%s)
  [ $((now-last)) -lt "$MIN_GAP" ] && return
  "$GEN" >/dev/null 2>&1
  last=$(date +%s)                      # cooldown starts when the pass ENDS
}

regen                                   # publish something before waiting on anything

# One long-lived reader emits a line whenever the database has moved, and a
# heartbeat regardless so wall-clock displays ("3 min idle") keep advancing.
TB_WEATHER_DB="$DB" python3 -u -c '
import os, sqlite3, time
db    = os.environ["TB_WEATHER_DB"]
pulse = float(os.environ.get("TB_WEATHER_PULSE", "0.5"))
beat  = float(os.environ.get("TB_WEATHER_BEAT", "30"))
con   = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
seen, last_beat = None, 0.0
while True:
    try:
        v = con.execute("PRAGMA data_version").fetchone()[0]
    except sqlite3.Error:
        time.sleep(2); continue
    now = time.monotonic()
    if seen is None:
        seen = v
    elif v != seen:
        seen = v; last_beat = now; print("change", flush=True)
    elif now - last_beat >= beat:
        last_beat = now; print("beat", flush=True)
    time.sleep(pulse)
' | while read -r _; do regen; done
