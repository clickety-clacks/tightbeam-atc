[Unit]
Description=Tightbeam Air Traffic Control (live model and viewer)
After=network.target

[Service]
Environment=TB_ATC_HOST=127.0.0.1
Environment=TB_ATC_PORT=8787
Environment=TB_ATC_WEB=%h/.local/share/tb-atc/web
EnvironmentFile=-%h/.config/tb-atc/service.env
ExecStart=%h/.local/share/tb-atc/.venv/bin/python %h/.local/share/tb-atc/server/tb-atc-api.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
